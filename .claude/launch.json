{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "staycovered.api:app", "--port", "8000", "--reload", "--reload-dir", "staycovered"],
      "port": 8000
